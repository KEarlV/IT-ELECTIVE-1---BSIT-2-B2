// 1. Count down from 10 to 1: Write a program that counds down from 10 to 1 using a loop.

using System;

public class HelloWorld
{
    public static void Main(string[] args)
    {
        for (int i = 10; i >= 1; i--)
        {
            Console.WriteLine(i);
        }
    } 
}

